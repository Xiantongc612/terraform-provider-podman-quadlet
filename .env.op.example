# Configuration for `devbox run dev`. Copy this file to `.env.op` and fill in
# the values you need. `.env.op` is gitignored so passwords stay local.

# Rootless Podman host for the demo. Defaults to the local machine.
# PODLET_DEMO_HOST=127.0.0.1

# Remote SSH user. Defaults to the local user.
# PODLET_DEMO_USER=containers

# Container HTTP port served by the hello demo.
# PODLET_DEMO_PORT=18080

# Path to an unencrypted SSH private key.
# PODLET_DEMO_KEY_PATH=~/.ssh/id_ed25519

# SSH password. Used when key or agent authentication is not available.
# PODLET_DEMO_PASSWORD=

# Leave the demo running after the script exits (1) instead of destroying it.
# PODLET_DEMO_KEEP=0
