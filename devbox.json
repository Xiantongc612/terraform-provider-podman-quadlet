{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "go@1.24",
    "golangci-lint@latest",
    "opentofu@latest",
    "terraform-plugin-docs@latest",
    "gitleaks@latest",
    "pre-commit@latest"
  ],
  "shell": {
    "init_hook": [],
    "scripts": {
      "init": [
        "go mod download",
        "pre-commit install"
      ],
      "fmt": [
        "gofmt -w -s $(git ls-files '*.go')",
        "tofu fmt -recursive examples"
      ],
      "fmt:check": [
        "golangci-lint run",
        "tofu fmt -check -recursive examples"
      ],
      "lint": [
        "golangci-lint run"
      ],
      "test": [
        "go test ./..."
      ],
      "build": [
        "go build -o terraform-provider-podlet ."
      ],
      "docs": [
        "PATH=\"$PWD/scripts:$PATH\" tfplugindocs generate --provider-name podlet"
      ],
      "docs:check": [
        "PATH=\"$PWD/scripts:$PATH\" tfplugindocs generate --provider-name podlet",
        "git diff --exit-code -- docs"
      ],
      "integration": [
        "go test -tags=integration ./internal/remote -run TestSSHIntegration -v"
      ],
      "check": [
        "tofu fmt -check -recursive examples",
        "go vet ./...",
        "golangci-lint run",
        "go test ./...",
        "go build -o terraform-provider-podlet .",
        "PATH=\"$PWD/scripts:$PATH\" tfplugindocs generate --provider-name podlet",
        "git diff --exit-code -- docs",
        "gitleaks git"
      ]
    }
  }
}
